{{- /*
settings.tmpl — Settings page: Notification Channels tab (S8a756d-3) +
Backup tab (Se1e7a6).
Visual SSOT: prototype/claude_design/Settings.html.
htmx-driven: tab switching via hx-get to re-render the content area.
Active tab is determined by Extra.ActiveTab ("notify" | "backup").
*/ -}}
{{ define "content" }}
<div class="page-head">
  <div>
    <h1 class="page-title">{{ T "page.settings.title" }}</h1>
    <p class="page-sub">{{ T "page.settings.subtitle" }}</p>
  </div>
</div>

<div class="settings-layout">
  <nav class="settings-nav" aria-label="設定セクション">
    {{ $tab := "notify" }}{{ if .Extra }}{{ if .Extra.ActiveTab }}{{ $tab = .Extra.ActiveTab }}{{ end }}{{ end }}
    <button
      {{ if eq $tab "notify" }}data-on="true" aria-current="page"{{ end }}
      hx-get="/ui/admin/settings?tab=notify"
      hx-target="#settings-content"
      hx-swap="innerHTML"
      hx-push-url="true">{{ T "page.settings.tab.notify" }}</button>
    <button
      data-testid="settings-tab-backup"
      {{ if eq $tab "backup" }}data-on="true" aria-current="page"{{ end }}
      hx-get="/ui/admin/settings?tab=backup"
      hx-target="#settings-content"
      hx-swap="innerHTML"
      hx-push-url="true">{{ T "page.settings.tab.backup" }}</button>
    <button
      data-testid="settings-tab-tls"
      {{ if eq $tab "tls" }}data-on="true" aria-current="page"{{ end }}
      hx-get="/ui/admin/settings?tab=tls"
      hx-target="#settings-content"
      hx-swap="innerHTML"
      hx-push-url="true">{{ T "page.settings.tab.tls" }}</button>
    <button
      data-testid="settings-tab-logs"
      {{ if eq $tab "logs" }}data-on="true" aria-current="page"{{ end }}
      hx-get="/ui/admin/settings?tab=logs"
      hx-target="#settings-content"
      hx-swap="innerHTML"
      hx-push-url="true">{{ T "page.settings.tab.logs" }}</button>
    <button
      data-testid="settings-tab-self-update"
      {{ if eq $tab "self_update" }}data-on="true" aria-current="page"{{ end }}
      hx-get="/ui/admin/settings?tab=self_update"
      hx-target="#settings-content"
      hx-swap="innerHTML"
      hx-push-url="true">{{ T "page.settings.tab.self_update" }}</button>
    <button
      data-testid="settings-tab-language"
      {{ if eq $tab "language" }}data-on="true" aria-current="page"{{ end }}
      hx-get="/ui/admin/settings?tab=language"
      hx-target="#settings-content"
      hx-swap="innerHTML"
      hx-push-url="true">{{ T "page.settings.tab.language" }}</button>
    <button
      data-testid="settings-tab-config"
      {{ if eq $tab "config" }}data-on="true" aria-current="page"{{ end }}
      hx-get="/ui/admin/settings?tab=config"
      hx-target="#settings-content"
      hx-swap="innerHTML"
      hx-push-url="true">{{ T "page.settings.tab.config" }}</button>
  </nav>

  <div class="col" style="min-width:0" id="settings-content">

  {{ $tab2 := "notify" }}{{ if .Extra }}{{ if .Extra.ActiveTab }}{{ $tab2 = .Extra.ActiveTab }}{{ end }}{{ end }}

  {{/* ======================================================= */}}
  {{/* ── Notify tab ─────────────────────────────────────────── */}}
  {{/* ======================================================= */}}
  {{ if eq $tab2 "notify" }}

    {{/* ── Notification channels table ────────────────────────── */}}
    <h2 class="section-title">{{ T "page.settings.notify.title" }}</h2>
    <p class="section-sub">{{ T "page.settings.notify.sub" }}</p>

    <div class="card" style="margin-bottom:16px" id="channels-card">
      <div class="card-head">
        <h3 class="card-title">{{ T "page.settings.channel.title" }}</h3>
        <button class="btn btn-sm" data-testid="add-channel-btn"
                hx-get="/ui/admin/settings/channels/add-form"
                hx-target="#channel-modal-container"
                hx-swap="innerHTML">{{ T "page.settings.channel.add_btn" }}</button>
      </div>

      {{ if .Extra }}{{ with .Extra }}{{ if .Channels }}
      <table class="tbl" data-testid="channels-table">
        <thead>
          <tr>
            <th>{{ T "page.settings.channel.col.name" }}</th>
            <th>{{ T "page.settings.channel.col.kind" }}</th>
            <th>{{ T "page.settings.channel.col.filter" }}</th>
            <th>{{ T "page.settings.channel.col.status" }}</th>
            <th></th>
          </tr>
        </thead>
        <tbody id="channels-tbody">
          {{ range .Channels }}
          <tr data-testid="channel-row-{{ .ID }}">
            <td class="td-mono">{{ .Name }}</td>
            <td><span class="badge">{{ .Kind }}</span></td>
            <td>
              <div style="display:flex;gap:4px;flex-wrap:wrap">
                {{ range .SeverityBadges }}
                <span class="badge {{ .Class }}"><span class="badge-dot"></span>{{ .Label }}</span>
                {{ end }}
              </div>
            </td>
            <td>
              {{ if .Enabled }}
              <span class="badge ok"><span class="badge-dot"></span>{{ T "page.settings.channel.status.active" }}</span>
              {{ else }}
              <span class="badge"><span class="badge-dot"></span>{{ T "page.settings.channel.status.paused" }}</span>
              {{ end }}
            </td>
            <td style="text-align:right;white-space:nowrap">
              <button class="btn btn-ghost btn-sm" data-testid="test-channel-{{ .ID }}"
                      hx-post="/ui/admin/settings/channels/{{ .ID }}/test"
                      hx-target="#test-result-{{ .ID }}"
                      hx-swap="innerHTML">{{ T "page.settings.channel.test_btn" }}</button>
              <span id="test-result-{{ .ID }}" style="font-size:12px;margin-left:4px"></span>
              <button class="btn btn-ghost btn-sm" data-testid="edit-channel-{{ .ID }}"
                      hx-get="/ui/admin/settings/channels/{{ .ID }}/edit-form"
                      hx-target="#channel-modal-container"
                      hx-swap="innerHTML">{{ T "page.settings.channel.edit_btn" }}</button>
              <button class="btn btn-ghost btn-sm" data-testid="delete-channel-{{ .ID }}"
                      hx-post="/ui/admin/settings/channels/{{ .ID }}/delete"
                      hx-confirm="{{ T "page.settings.channel.delete.confirm" }}"
                      hx-target="#channels-card"
                      hx-swap="outerHTML">{{ T "page.settings.channel.delete_btn" }}</button>
            </td>
          </tr>
          {{ end }}
        </tbody>
      </table>
      {{ else }}
      <div class="card-body" data-testid="channels-empty">
        <p class="muted" style="font-size:13px;margin:0">{{ T "page.settings.channel.empty" }}</p>
      </div>
      {{ end }}{{ end }}{{ end }}
    </div>

    {{/* Modal container — htmx swaps the form HTML here */}}
    <div id="channel-modal-container"></div>

    {{/* ── Event log table ────────────────────────────────────── */}}
    <div class="card" id="event-log-card">
      <div class="card-head">
        <h3 class="card-title">{{ T "page.settings.events.title" }}</h3>
        <form style="display:flex;gap:8px" hx-get="/ui/admin/settings" hx-target="#event-log-card" hx-swap="outerHTML" hx-push-url="false">
          <div class="search" style="width:200px">
            <input name="sev" placeholder="{{ T "page.settings.events.filter" }}"
                   value="{{ if .Extra }}{{ .Extra.SeverityFilter }}{{ end }}" />
          </div>
          <button class="btn btn-sm" type="submit">{{ T "btn.apply" }}</button>
        </form>
      </div>
      <table class="tbl" data-testid="events-table">
        <thead>
          <tr>
            <th>{{ T "page.settings.events.col.time" }}</th>
            <th>{{ T "page.settings.events.col.severity" }}</th>
            <th>{{ T "page.settings.events.col.category" }}</th>
            <th>{{ T "page.settings.events.col.message" }}</th>
          </tr>
        </thead>
        <tbody>
          {{ if .Extra }}{{ with .Extra }}{{ if .Events }}
          {{ range .Events }}
          <tr data-testid="event-row">
            <td class="td-mono">{{ .TimeFmt }}</td>
            <td><span class="badge {{ .SeverityClass }}"><span class="badge-dot"></span>{{ .Severity }}</span></td>
            <td><span class="badge">{{ .Category }}</span></td>
            <td>{{ .Title }}</td>
          </tr>
          {{ end }}
          {{ else }}
          <tr><td colspan="4" style="text-align:center;color:var(--text-3);padding:24px" data-testid="events-empty">{{ T "page.settings.events.empty" }}</td></tr>
          {{ end }}{{ end }}{{ end }}
        </tbody>
      </table>
    </div>

  {{ end }}{{/* end notify tab */}}

  {{/* ======================================================= */}}
  {{/* ── Backup tab ──────────────────────────────────────────── */}}
  {{/* ======================================================= */}}
  {{ if eq $tab2 "backup" }}

    {{/* ── Snapshot schedules ──────────────────────────────── */}}
    <h2 class="section-title" data-testid="backup-section-title">{{ T "page.settings.backup.title" }}</h2>
    <p class="section-sub">{{ T "page.settings.backup.sub" }}</p>

    <div class="card" style="margin-bottom:16px" id="schedules-card">
      <div class="card-head">
        <h3 class="card-title">{{ T "page.settings.backup.schedule.title" }}</h3>
        <button class="btn btn-sm" data-testid="add-schedule-btn"
                hx-get="/ui/admin/settings/backup/schedules/add-form"
                hx-target="#schedule-modal-container"
                hx-swap="innerHTML">{{ T "page.settings.backup.schedule.add_btn" }}</button>
      </div>

      {{ if .Extra }}{{ with .Extra }}{{ if .Schedules }}
      <table class="tbl" data-testid="schedules-table">
        <thead>
          <tr>
            <th>{{ T "page.settings.backup.col.name" }}</th>
            <th>{{ T "page.settings.backup.col.cron" }}</th>
            <th>{{ T "page.settings.backup.col.datasets" }}</th>
            <th>{{ T "page.settings.backup.col.retention" }}</th>
            <th></th>
          </tr>
        </thead>
        <tbody>
          {{ range .Schedules }}
          <tr data-testid="schedule-row-{{ .ID }}">
            <td class="td-mono">{{ .Name }}</td>
            <td class="td-mono">{{ .CronExpr }}</td>
            <td>
              {{ range .Datasets }}
              <span class="badge">{{ . }}</span>
              {{ end }}
            </td>
            <td style="font-size:12px">
              {{ if .RetHourly }}<span class="badge">{{ T "page.backup.retention.hourly" .RetHourly }}</span>{{ end }}
              {{ if .RetDaily }}<span class="badge">{{ T "page.backup.retention.daily" .RetDaily }}</span>{{ end }}
              {{ if .RetMonthly }}<span class="badge">{{ T "page.backup.retention.monthly" .RetMonthly }}</span>{{ end }}
            </td>
            <td style="text-align:right;white-space:nowrap">
              <button class="btn btn-ghost btn-sm" data-testid="edit-schedule-{{ .ID }}"
                      hx-get="/ui/admin/settings/backup/schedules/{{ .ID }}/edit-form"
                      hx-target="#schedule-modal-container"
                      hx-swap="innerHTML">{{ T "page.settings.backup.edit_btn" }}</button>
              <button class="btn btn-ghost btn-sm" data-testid="delete-schedule-{{ .ID }}"
                      hx-post="/ui/admin/settings/backup/schedules/{{ .ID }}/delete"
                      hx-confirm="{{ T "page.settings.backup.delete.confirm" }}"
                      hx-target="#schedules-card"
                      hx-swap="outerHTML">{{ T "page.settings.backup.delete_btn" }}</button>
            </td>
          </tr>
          {{ end }}
        </tbody>
      </table>
      {{ else }}
      <div class="card-body" data-testid="schedules-empty">
        <p class="muted" style="font-size:13px;margin:0">{{ T "page.settings.backup.schedule.empty" }}</p>
      </div>
      {{ end }}{{ end }}{{ end }}
    </div>

    <div id="schedule-modal-container"></div>

    {{/* ── Offsite backends ─────────────────────────────────── */}}
    <div class="card" style="margin-bottom:16px" id="backends-card">
      <div class="card-head">
        <h3 class="card-title">{{ T "page.settings.backend.title" }}</h3>
        <button class="btn btn-sm" data-testid="add-backend-btn"
                hx-get="/ui/admin/settings/backup/backends/add-form"
                hx-target="#backend-modal-container"
                hx-swap="innerHTML">{{ T "page.settings.backend.add_btn" }}</button>
      </div>

      {{ if .Extra }}{{ with .Extra }}{{ if .Backends }}
      <table class="tbl" data-testid="backends-table">
        <thead>
          <tr>
            <th>{{ T "page.settings.backend.col.name" }}</th>
            <th>{{ T "page.settings.backend.col.kind" }}</th>
            <th>{{ T "page.settings.backend.col.status" }}</th>
            <th></th>
          </tr>
        </thead>
        <tbody>
          {{ range .Backends }}
          <tr data-testid="backend-row-{{ .ID }}">
            <td class="td-mono">{{ .Name }}</td>
            <td><span class="badge">{{ .Kind }}</span></td>
            <td>
              {{ if eq .CredentialState "set" }}
              <span class="badge ok"><span class="badge-dot"></span>設定済み</span>
              {{ else }}
              <span class="badge warn"><span class="badge-dot"></span>未設定</span>
              {{ end }}
            </td>
            <td style="text-align:right;white-space:nowrap">
              <button class="btn btn-ghost btn-sm" data-testid="edit-backend-{{ .ID }}"
                      hx-get="/ui/admin/settings/backup/backends/{{ .ID }}/edit-form"
                      hx-target="#backend-modal-container"
                      hx-swap="innerHTML">{{ T "page.settings.backend.edit_btn" }}</button>
              <button class="btn btn-ghost btn-sm" data-testid="delete-backend-{{ .ID }}"
                      hx-post="/ui/admin/settings/backup/backends/{{ .ID }}/delete"
                      hx-confirm="{{ T "page.settings.backend.delete.confirm" }}"
                      hx-target="#backends-card"
                      hx-swap="outerHTML">{{ T "page.settings.backend.delete_btn" }}</button>
            </td>
          </tr>
          {{ end }}
        </tbody>
      </table>
      {{ else }}
      <div class="card-body" data-testid="backends-empty">
        <p class="muted" style="font-size:13px;margin:0">{{ T "page.settings.backend.empty" }}</p>
      </div>
      {{ end }}{{ end }}{{ end }}
    </div>

    <div id="backend-modal-container"></div>

    {{/* ── System upgrade ───────────────────────────────────── */}}
    <div class="card" id="upgrade-card">
      <div class="card-head">
        <h3 class="card-title">{{ T "page.settings.upgrade.title" }}</h3>
      </div>
      <div class="card-body" style="display:flex;align-items:center;justify-content:space-between;gap:16px">
        <p style="margin:0;font-size:13px;color:var(--text-2)">{{ T "page.settings.upgrade.sub" }}</p>
        <button class="btn btn-primary" data-testid="upgrade-btn"
                hx-post="/ui/admin/settings/upgrade/run"
                hx-confirm="{{ T "page.settings.upgrade.confirm" }}"
                hx-target="#upgrade-result"
                hx-swap="innerHTML"
                hx-indicator="#upgrade-spinner">{{ T "page.settings.upgrade.btn" }}</button>
      </div>
      <div id="upgrade-result" style="padding:0 16px 16px;font-size:13px"></div>
      <div id="upgrade-spinner" class="htmx-indicator" style="padding:0 16px 8px;font-size:13px;color:var(--text-3)">
        {{ T "page.settings.upgrade.running" }}
      </div>
    </div>

  {{ end }}{{/* end backup tab */}}

  {{/* ======================================================= */}}
  {{/* ── TLS tab ────────────────────────────────────────────── */}}
  {{/* ======================================================= */}}
  {{ if eq $tab2 "tls" }}
  <h2 class="section-title" data-testid="tls-section-title">{{ T "page.settings.tls.title" }}</h2>
  <p class="section-sub">{{ T "page.settings.tls.sub" }}</p>

  {{ if .Extra }}{{ with .Extra }}
  {{ if .SuccessMsg }}
  <div class="banner ok" data-testid="tls-success" style="margin-bottom:16px">
    <span>{{ .SuccessMsg }}</span>
  </div>
  {{ end }}
  {{ if .ErrorMsg }}
  <div class="banner crit" data-testid="tls-error" style="margin-bottom:16px">
    <span>{{ .ErrorMsg }}</span>
  </div>
  {{ end }}
  {{ end }}{{ end }}

  <div class="card" id="tls-card">
    <div class="card-body">
      <form method="POST" action="/ui/admin/settings/tls/apply"
            hx-post="/ui/admin/settings/tls/apply"
            hx-target="body"
            hx-swap="innerHTML"
            data-testid="tls-form">

        <div style="margin-bottom:16px">
          <label class="label" for="tls-mode">{{ T "page.settings.tls.mode.label" }}</label>
          <select id="tls-mode" name="mode" class="input" data-testid="tls-mode-select">
            <option value="none"{{ if .Extra }}{{ if eq .Extra.Mode "none" }} selected{{ end }}{{ end }}>{{ T "page.settings.tls.mode.none" }}</option>
            <option value="self_signed"{{ if .Extra }}{{ if eq .Extra.Mode "self_signed" }} selected{{ end }}{{ end }}>{{ T "page.settings.tls.mode.self_signed" }}</option>
            <option value="acme"{{ if .Extra }}{{ if eq .Extra.Mode "acme" }} selected{{ end }}{{ end }}>{{ T "page.settings.tls.mode.acme" }}</option>
          </select>
        </div>

        <div style="margin-bottom:16px">
          <label class="label" for="tls-port">{{ T "page.settings.tls.port.label" }}</label>
          <input id="tls-port" name="port" class="input" type="number" min="1" max="65535"
                 value="{{ if .Extra }}{{ .Extra.Port }}{{ else }}8443{{ end }}"
                 data-testid="tls-port-input" />
        </div>

        <div style="margin-bottom:16px">
          <label class="label" for="tls-provider">{{ T "page.settings.tls.provider.label" }}</label>
          <select id="tls-provider" name="provider" class="input" data-testid="tls-provider-select">
            <option value="">—</option>
            {{ if .Extra }}{{ range .Extra.AvailableProviders }}
            <option value="{{ . }}"{{ if eq . $.Extra.Provider }} selected{{ end }}>{{ . }}</option>
            {{ end }}{{ end }}
          </select>
        </div>

        <div style="margin-bottom:16px">
          <label class="label" for="tls-domains">{{ T "page.settings.tls.domains.label" }}</label>
          <input id="tls-domains" name="domains" class="input" type="text"
                 placeholder="{{ T "page.settings.tls.domains.hint" }}"
                 value="{{ if .Extra }}{{ .Extra.Domains }}{{ end }}"
                 data-testid="tls-domains-input" />
        </div>

        {{ if .Extra }}{{ with .Extra }}{{ if .CACertPath }}
        <div class="banner ok" style="margin-bottom:16px" data-testid="tls-ca-hint">
          <span>{{ T "page.settings.tls.ca.hint" }}</span>
          <a href="/ui/admin/settings/tls/ca" download class="btn btn-ghost btn-sm" style="margin-left:8px">
            {{ T "page.settings.tls.ca.download" }}
          </a>
        </div>
        {{ end }}{{ end }}{{ end }}

        <div style="text-align:right">
          <button type="submit" class="btn btn-primary" data-testid="tls-apply-btn">
            {{ T "page.settings.tls.apply_btn" }}
          </button>
        </div>
      </form>
    </div>
  </div>
  {{ end }}{{/* end tls tab */}}

  {{/* ======================================================= */}}
  {{/* ── Logs tab ────────────────────────────────────────────── */}}
  {{/* ======================================================= */}}
  {{ if eq $tab2 "logs" }}
  <h2 class="section-title" data-testid="logs-section-title">{{ T "page.settings.logs.title" }}</h2>
  <p class="section-sub">{{ T "page.settings.logs.sub" }}</p>

  <div class="card" id="logs-card">
    <div class="card-head">
      <h3 class="card-title">{{ T "page.settings.logs.title" }}</h3>
      <div style="display:flex;gap:8px;align-items:center">
        <form style="display:flex;gap:6px" hx-get="/ui/admin/settings?tab=logs"
              hx-target="#logs-card" hx-swap="outerHTML" hx-push-url="false">
          <select name="source" class="input" style="width:120px" data-testid="logs-source-filter">
            <option value="">{{ T "page.settings.logs.source.label" }}</option>
            <option value="kuraos"{{ if .Extra }}{{ if eq .Extra.Source "kuraos" }} selected{{ end }}{{ end }}>kuraos</option>
            <option value="journald"{{ if .Extra }}{{ if eq .Extra.Source "journald" }} selected{{ end }}{{ end }}>journald</option>
          </select>
          <select name="level" class="input" style="width:100px" data-testid="logs-level-filter">
            <option value="">{{ T "page.settings.logs.level.label" }}</option>
            <option value="debug">debug</option>
            <option value="info">info</option>
            <option value="warn">warn</option>
            <option value="error">error</option>
          </select>
          <input name="search" class="input" type="text" style="width:140px"
                 placeholder="{{ T "page.settings.logs.search.hint" }}"
                 value="{{ if .Extra }}{{ .Extra.Search }}{{ end }}"
                 data-testid="logs-search-input" />
          <button type="submit" class="btn btn-sm">{{ T "page.settings.logs.filter_btn" }}</button>
        </form>
        <button class="btn btn-sm" data-testid="logs-live-btn"
                onclick="startLogSSE(this)"
                style="margin-left:4px">{{ T "page.settings.logs.live_btn" }}</button>
      </div>
    </div>

    <table class="tbl" data-testid="logs-table">
      <thead>
        <tr>
          <th>{{ T "page.settings.logs.col.time" }}</th>
          <th>{{ T "page.settings.logs.col.level" }}</th>
          <th>{{ T "page.settings.logs.col.source" }}</th>
          <th>{{ T "page.settings.logs.col.message" }}</th>
        </tr>
      </thead>
      <tbody id="logs-tbody" data-testid="logs-tbody">
        {{ if .Extra }}{{ with .Extra }}{{ if .Entries }}
        {{ range .Entries }}
        <tr class="log-row" data-testid="log-row">
          <td class="td-mono">{{ .TimeFmt }}</td>
          <td><span class="badge {{ .LvlClass }}">{{ .Level }}</span></td>
          <td><span class="badge">{{ .Source }}</span></td>
          <td>{{ .Message }}</td>
        </tr>
        {{ end }}
        {{ else }}
        <tr><td colspan="4" style="text-align:center;color:var(--text-3);padding:24px" data-testid="logs-empty">{{ T "page.settings.logs.empty" }}</td></tr>
        {{ end }}{{ end }}{{ end }}
      </tbody>
    </table>
  </div>

  <script>
  function startLogSSE(btn) {
    btn.disabled = true;
    var source = document.querySelector('[name=source]')?.value || '';
    var level = document.querySelector('[name=level]')?.value || '';
    var search = document.querySelector('[name=search]')?.value || '';
    var url = '/ui/admin/settings/logs/stream?source=' + encodeURIComponent(source) +
              '&level=' + encodeURIComponent(level) +
              '&search=' + encodeURIComponent(search);
    var es = new EventSource(url);
    var tbody = document.getElementById('logs-tbody');
    es.onmessage = function(e) {
      tbody.insertAdjacentHTML('afterbegin', e.data);
    };
    es.onerror = function() { es.close(); btn.disabled = false; };
  }
  </script>
  {{ end }}{{/* end logs tab */}}

  {{/* ======================================================= */}}
  {{/* ── Self-update tab ────────────────────────────────────── */}}
  {{/* ======================================================= */}}
  {{ if eq $tab2 "self_update" }}
  <h2 class="section-title" data-testid="self-update-section-title">{{ T "page.settings.self_update.title" }}</h2>
  <p class="section-sub">{{ T "page.settings.self_update.sub" }}</p>

  {{ if .Extra }}{{ with .Extra }}
  {{ if .SuccessMsg }}
  <div class="banner ok" data-testid="self-update-success" style="margin-bottom:16px">
    <span>{{ .SuccessMsg }}</span>
  </div>
  {{ end }}
  {{ if .ErrorMsg }}
  <div class="banner crit" data-testid="self-update-error" style="margin-bottom:16px">
    <span>{{ .ErrorMsg }}</span>
  </div>
  {{ end }}
  {{ end }}{{ end }}

  <div class="card" id="self-update-card">
    <div class="card-body">
      <div style="display:grid;grid-template-columns:1fr 1fr;gap:16px;margin-bottom:16px">
        <div>
          <p class="label">{{ T "page.settings.self_update.current" }}</p>
          <p class="td-mono" data-testid="current-version">{{ if .Extra }}{{ .Extra.CurrentVersion }}{{ end }}</p>
        </div>
        {{ if .Extra }}{{ with .Extra }}{{ if .LatestVersion }}
        <div>
          <p class="label">{{ T "page.settings.self_update.latest" }}</p>
          <p class="td-mono" data-testid="latest-version">{{ .LatestVersion }}</p>
        </div>
        {{ end }}{{ end }}{{ end }}
      </div>

      {{ if .Extra }}{{ with .Extra }}
      {{ if .Available }}
      <div class="banner warn" style="margin-bottom:16px" data-testid="update-available-banner">
        <span>{{ T "page.settings.self_update.available" .LatestVersion }}</span>
      </div>
      {{ else if .LatestVersion }}
      <div class="banner ok" style="margin-bottom:16px" data-testid="up-to-date-banner">
        <span>{{ T "page.settings.self_update.up_to_date" }}</span>
      </div>
      {{ end }}
      {{ end }}{{ end }}

      <div style="display:flex;gap:8px">
        <form method="POST" action="/ui/admin/settings/self-update/check"
              hx-post="/ui/admin/settings/self-update/check"
              hx-target="#self-update-card"
              hx-swap="outerHTML">
          <button type="submit" class="btn" data-testid="check-update-btn">
            {{ T "page.settings.self_update.check_btn" }}
          </button>
        </form>
        {{ if .Extra }}{{ with .Extra }}{{ if .Available }}
        <form method="POST" action="/ui/admin/settings/self-update/apply"
              hx-post="/ui/admin/settings/self-update/apply"
              hx-target="#self-update-card"
              hx-swap="outerHTML"
              hx-confirm="{{ T "page.settings.self_update.confirm" .LatestVersion }}">
          <button type="submit" class="btn btn-primary" data-testid="apply-update-btn">
            {{ T "page.settings.self_update.apply_btn" }}
          </button>
        </form>
        {{ end }}{{ end }}{{ end }}
      </div>
    </div>
  </div>
  {{ end }}{{/* end self-update tab */}}

  {{/* ======================================================= */}}
  {{/* ── Language tab ─────────────────────────────────────── */}}
  {{/* ======================================================= */}}
  {{ if eq $tab2 "language" }}
  <div id="language-card" data-testid="language-card">
    <h2 class="section-title">{{ T "page.settings.language.title" }}</h2>
    <p class="section-sub">{{ T "page.settings.language.sub" }}</p>

    {{ if .Extra }}{{ with .Extra }}{{ if .LangSaved }}
    <div class="banner ok" style="margin-bottom:16px" data-testid="lang-saved-banner">
      <span>{{ T "page.settings.language.saved" }}</span>
    </div>
    {{ end }}{{ end }}{{ end }}

    <div class="card" style="margin-bottom:16px">
      <form method="POST" action="/ui/admin/settings/language/save"
            hx-post="/ui/admin/settings/language/save"
            hx-target="#language-card"
            hx-swap="outerHTML">
        <div style="display:flex;flex-direction:column;gap:12px;padding:16px">
          <label style="display:flex;align-items:center;gap:8px;cursor:pointer">
            <input type="radio" name="locale" value="ja" checked
                   data-testid="locale-ja-radio">
            <span>{{ T "page.settings.language.ja" }}</span>
          </label>
          <label style="display:flex;align-items:center;gap:8px;cursor:not-allowed;opacity:0.5">
            <input type="radio" name="locale" value="en" disabled
                   data-testid="locale-en-radio">
            <span>{{ T "page.settings.language.en" }}
              <span class="badge" style="font-size:10px;margin-left:4px">v1.x</span>
            </span>
          </label>
          <p class="section-sub" style="margin:0">{{ T "page.settings.language.en_hint" }}</p>
        </div>
        <div style="padding:0 16px 16px">
          <button type="submit" class="btn btn-primary" data-testid="save-language-btn">
            {{ T "btn.save" }}
          </button>
        </div>
      </form>
    </div>
  </div>
  {{ end }}{{/* end language tab */}}

  {{/* ======================================================= */}}
  {{/* ── Config tab ─────────────────────────────────────────── */}}
  {{/* ======================================================= */}}
  {{ if eq $tab2 "config" }}
  <div id="config-card" data-testid="config-card">
    <h2 class="section-title">{{ T "page.settings.config.title" }}</h2>
    <p class="section-sub">{{ T "page.settings.config.sub" }}</p>

    {{ if .Extra }}{{ with .Extra }}{{ if .ConfigImportOK }}
    <div class="banner ok" style="margin-bottom:16px" data-testid="config-import-ok-banner">
      <span>{{ T "page.settings.config.import_ok" }}</span>
    </div>
    {{ end }}{{ if .ConfigImportErr }}
    <div class="banner error" style="margin-bottom:16px" data-testid="config-import-err-banner">
      <span>{{ .ConfigImportErr }}</span>
    </div>
    {{ end }}{{ end }}{{ end }}

    {{/* Export section */}}
    <div class="card" style="margin-bottom:16px">
      <div class="card-head">
        <h3 class="card-title">{{ T "page.settings.config.export_btn" }}</h3>
      </div>
      <div style="padding:16px">
        <a href="/ui/admin/settings/config/export"
           class="btn"
           data-testid="config-export-btn"
           download="config.json">{{ T "page.settings.config.export_btn" }}</a>
      </div>
    </div>

    {{/* Import section */}}
    <div class="card" style="margin-bottom:16px">
      <div class="card-head">
        <h3 class="card-title">{{ T "page.settings.config.import_btn" }}</h3>
      </div>
      <div style="padding:16px">
        <p class="section-sub" style="margin-bottom:12px">{{ T "page.settings.config.import_hint" }}</p>
        <form method="POST" action="/ui/admin/settings/config/import"
              enctype="multipart/form-data"
              hx-post="/ui/admin/settings/config/import"
              hx-target="#config-card"
              hx-swap="outerHTML"
              hx-encoding="multipart/form-data">
          <div style="display:flex;gap:8px;align-items:center">
            <input type="file" name="config_file" accept=".json"
                   data-testid="config-import-file-input"
                   style="flex:1">
            <button type="submit" class="btn btn-primary" data-testid="config-import-btn">
              {{ T "page.settings.config.import_btn" }}
            </button>
          </div>
        </form>
      </div>
    </div>
  </div>
  {{ end }}{{/* end config tab */}}

  </div>
</div>
{{ end }}
