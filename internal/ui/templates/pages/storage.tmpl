{{- /*
storage.tmpl — admin /ui/admin/storage page. Visual SSOT is
prototype/claude_design/Storage.html: PoolCard grid + import banner + disks
table + dialogs.

Modal vocabulary refactored to the reusable {{ template "modal" }} partial
(see internal/ui/templates/partials/modal.tmpl). All modal behaviors
(scroll lock, ESC, backdrop click-to-close, data-modal-open / data-modal-close
buttons) are auto-wired by /ui/static/kura.js — page scripts only need to
add the form-specific validation logic via kura.gateForm().

Data shape: PageData.Extra is a StorageView. All strings are pre-translated
in storage.go so the template stays free of CLI-output tokens.
*/ -}}
{{ define "content" }}
{{ $v := .Extra }}
<div class="page-head">
  <div>
    <h1 class="page-title">{{ T "page.storage.title" }}</h1>
    <p class="page-sub">{{ $v.Subtitle }}</p>
  </div>
  <div class="row gap-sm" style="display:flex;gap:8px;">
    {{ if $v.WriteEnabled }}
    <button type="button" class="btn btn-primary" data-testid="storage-new-pool-btn"
      data-modal-open="new-pool-modal">
      {{ T "page.storage.new_pool" }}
    </button>
    {{ else }}
    <button type="button" class="btn" disabled aria-disabled="true" title="{{ T "page.storage.new_pool_deferred" }}">
      {{ T "page.storage.new_pool" }}
    </button>
    {{ end }}
  </div>
</div>

{{ if $v.ImportError }}
<div class="banner crit" data-testid="storage-error" style="margin-bottom:20px">
  <div style="flex:1">{{ $v.ImportError }}</div>
</div>
{{ end }}

{{ if $v.Importer.Visible }}
<div class="banner" data-testid="storage-import-banner" style="margin-bottom:20px">
  <div style="flex:1">
    <div style="font-weight:550">{{ $v.Importer.BannerText }}</div>
    {{ if not $v.WriteEnabled }}
    <div style="font-size:11px;color:var(--text-3);margin-top:2px">{{ $v.Importer.Deferred }}</div>
    {{ end }}
  </div>
  {{ if $v.WriteEnabled }}
  <button type="button" class="btn btn-sm" data-testid="storage-import-inspect-btn"
    data-modal-open="import-modal-{{ $v.Importer.First }}">
    {{ T "page.storage.import_inspect" }}
  </button>
  {{ else }}
  <button type="button" class="btn btn-sm" disabled aria-disabled="true">{{ T "page.storage.import_inspect" }}</button>
  {{ end }}
</div>
{{ end }}

{{ if $v.HasPools }}
<section data-testid="storage-pools" style="margin-bottom:24px">
  <div class="grid grid-2">
    {{ range $v.Pools }}
    <div class="card" data-testid="storage-pool-card" data-pool="{{ .Name }}">
      <div class="card-head">
        <div class="row center" style="display:flex;gap:12px;align-items:center">
          <div>
            <h3 class="card-title">{{ .Name }}</h3>
            <p class="card-sub mono">{{ .Topology }}</p>
          </div>
        </div>
        <span class="badge {{ .HealthClass }}" data-health="{{ .HealthBadge }}"><span class="badge-dot"></span>{{ .HealthBadge }}</span>
      </div>
      <div class="card-body">
        <div class="row between center" style="display:flex;justify-content:space-between;align-items:center;margin-bottom:8px">
          <span class="stat-value">{{ .UsedDisplay }}<span class="unit"> / {{ .SizeDisplay }}</span></span>
          <span class="muted mono" style="font-size:11px">{{ .CapPercent }}%</span>
        </div>
        <div class="bar {{ .BarClass }}"><span style="width:{{ .CapPercent }}%"></span></div>
        <div class="row between" style="display:flex;justify-content:space-between;margin-top:8px;font-size:12px;color:var(--text-3)">
          <span>{{ .UsedSentence }}</span>
          <span>{{ .FragSentence }}</span>
        </div>

        {{ if .Vdevs }}
        <div class="vdev-tree" data-testid="storage-pool-topology" style="margin-top:14px;border-top:1px solid var(--border);padding-top:10px">
          {{ range .Vdevs }}
          <div class="vdev-row" style="font-size:12px;line-height:1.5">
            <span class="mono" style="color:var(--text-2)">{{ .TypeLabel }}{{ if .Layout }} ({{ .Layout }}){{ end }}</span>
            {{ if .HealthBadge }}<span class="badge {{ .HealthClass }}" style="margin-left:8px"><span class="badge-dot"></span>{{ .HealthBadge }}</span>{{ end }}
            {{ if .Children }}
            <ul style="margin:4px 0 6px 18px;padding:0;list-style:none">
              {{ range .Children }}
              <li class="row center" style="display:flex;gap:8px;align-items:center;font-size:11px;margin:1px 0">
                <span class="mono" style="color:var(--text-3)">{{ .Path }}</span>
                {{ if .HealthBadge }}<span class="badge {{ .HealthClass }}"><span class="badge-dot"></span>{{ .HealthBadge }}</span>{{ end }}
              </li>
              {{ end }}
            </ul>
            {{ end }}
          </div>
          {{ end }}
        </div>
        {{ end }}
      </div>
      <div class="card-foot">
        <span>{{ T "page.storage.pool.data_intact" }}</span>
      </div>
    </div>
    {{ end }}
  </div>
</section>
{{ else }}
<div class="card" data-testid="storage-empty">
  <div class="card-body">
    <p class="muted" style="margin:0">{{ T "page.storage.empty" }}</p>
  </div>
</div>
{{ end }}

{{ if $v.HasDisks }}
<section data-testid="storage-disks" style="margin-top:24px">
  <div class="card">
    <div class="card-head">
      <h3 class="card-title">{{ T "page.storage.disks_heading" }}</h3>
    </div>
    <table class="tbl">
      <thead>
        <tr>
          <th>{{ T "page.storage.disks.col.device" }}</th>
          <th>{{ T "page.storage.disks.col.model" }}</th>
          <th>{{ T "page.storage.disks.col.pool" }}</th>
          <th class="td-num">{{ T "page.storage.disks.col.size" }}</th>
          <th class="td-num">{{ T "page.storage.disks.col.temp" }}</th>
          <th class="td-num">{{ T "page.storage.disks.col.hours" }}</th>
          <th>{{ T "page.storage.disks.col.smart" }}</th>
          <th>{{ T "page.storage.disks.col.usage" }}</th>
        </tr>
      </thead>
      <tbody>
        {{ range $v.Disks }}
        <tr data-testid="storage-disk-row" data-path="{{ .Path }}">
          <td><span class="mono">{{ .Path }}</span></td>
          <td>
            <div style="font-size:13px">{{ .Model }}</div>
            {{ if .Serial }}<div class="mono" style="font-size:11px;color:var(--text-3)">S/N {{ .Serial }}</div>{{ end }}
          </td>
          <td>{{ if .Pool }}<span class="badge">{{ .Pool }}</span>{{ else }}<span class="muted">—</span>{{ end }}</td>
          <td class="td-num">{{ .SizeDisplay }}</td>
          <td class="td-num">{{ .TempDisplay }}</td>
          <td class="td-num">{{ .HoursLabel }}</td>
          <td><span class="badge {{ .SMARTClass }}" data-smart="{{ .SMARTBadge }}"><span class="badge-dot"></span>{{ .SMARTBadge }}</span></td>
          <td><span class="badge {{ .UsageClass }}">{{ .UsageLabel }}</span></td>
        </tr>
        {{ end }}
      </tbody>
    </table>
  </div>
</section>
{{ end }}

{{ if $v.HasImports }}
<section data-testid="storage-import" style="margin-top:24px">
  <div class="card">
    <div class="card-head">
      <h3 class="card-title">{{ T "page.storage.import_heading" }}</h3>
      {{ if not $v.WriteEnabled }}
      <p class="card-sub">{{ T "page.storage.import_deferred" }}</p>
      {{ end }}
    </div>
    <table class="tbl">
      <thead>
        <tr>
          <th>{{ T "page.storage.import.col.name" }}</th>
          <th>{{ T "page.storage.import.col.guid" }}</th>
          <th>{{ T "page.storage.import.col.state" }}</th>
          <th>{{ T "page.storage.import.col.topology" }}</th>
          {{ if $v.WriteEnabled }}<th></th>{{ end }}
        </tr>
      </thead>
      <tbody>
        {{ range $v.Imports }}
        <tr data-testid="storage-import-row" data-pool="{{ .Name }}">
          <td><span class="mono">{{ .Name }}</span></td>
          <td><span class="mono" style="font-size:11px">{{ .GUID }}</span></td>
          <td><span class="badge {{ .StateClass }}"><span class="badge-dot"></span>{{ .StateBadge }}</span></td>
          <td class="mono" style="font-size:12px">{{ .Topology }}</td>
          {{ if $v.WriteEnabled }}
          <td style="text-align:right">
            <button type="button" class="btn btn-sm" data-testid="storage-import-row-action"
              data-modal-open="import-modal-{{ .Name }}">
              {{ T "page.storage.import.confirm" }}
            </button>
          </td>
          {{ end }}
        </tr>
        {{ end }}
      </tbody>
    </table>
  </div>
</section>
{{ end }}

{{- /* ===== Modals (rendered via reusable partial) ===== */ -}}

{{ if $v.WriteEnabled }}
{{ range $v.Imports }}
{{ template "modal" dict
    "id"      (printf "import-modal-%s" .Name)
    "testid"  "storage-import-modal"
    "title"   (printf "%s: %s" (T "page.storage.import.confirm") .Name)
    "action"  "/ui/admin/storage/import"
    "bodyTpl" "storage-import-modal-body"
    "footTpl" "storage-import-modal-foot"
    "ctx"     . }}
{{ end }}

{{ template "modal" dict
    "id"      "new-pool-modal"
    "testid"  "storage-new-pool-modal"
    "title"   (T "page.storage.new_pool.title")
    "action"  "/ui/admin/storage/pools"
    "bodyTpl" "storage-new-pool-body"
    "footTpl" "storage-new-pool-foot"
    "ctx"     $v }}

{{- /* ===== Pool-form validation script (page-specific) =====
   The validation rules depend on which layout is selected, so the logic
   stays here. kura.gateForm wires the standard submit-button gating
   (aria-disabled + tooltip + submit blocking). The cross-picker dedup is
   storage-specific and runs as a side-effect inside the validate
   callback. i18n strings are injected via the JSON island below.       */ -}}
<script type="application/json" id="storage-validation-msgs">
{
  "name_required":           "{{ T "page.storage.new_pool.err.name_required" }}",
  "data_layout_required":    "{{ T "page.storage.new_pool.err.data_layout_required" }}",
  "data_too_few":            "{{ T "page.storage.new_pool.err.data_too_few" }}",
  "special_layout_required": "{{ T "page.storage.new_pool.err.special_layout_required" }}",
  "special_too_few":         "{{ T "page.storage.new_pool.err.special_too_few" }}",
  "duplicate_disk":          "{{ T "page.storage.new_pool.err.duplicate_disk" }}"
}
</script>
<script>
(function () {
  var modal = document.getElementById('new-pool-modal');
  if (!modal) return;
  var form = modal.querySelector('form');
  if (!form) return;

  var msgs = {};
  try {
    msgs = JSON.parse(document.getElementById('storage-validation-msgs').textContent);
  } catch (_) {}

  var layoutMin = { single: 1, mirror: 2, raidz1: 3, raidz2: 4, raidz3: 5 };
  var fields = ['data_disks', 'special_disks', 'spares'];

  function fmt(tpl, params) {
    return (tpl || '').replace(/\{(\w+)\}/g, function (_, k) {
      return (params[k] != null) ? params[k] : '{' + k + '}';
    });
  }

  function selectedSet(name) {
    var nodes = form.querySelectorAll('input[type="checkbox"][name="' + name + '"]:checked');
    var s = new Set();
    for (var i = 0; i < nodes.length; i++) s.add(nodes[i].value);
    return s;
  }

  // Cross-picker dedup: gray out rows whose disk is selected in another
  // picker. The selected row in its own picker stays interactive so the
  // operator can deselect it without first unchecking elsewhere.
  function applyDedup(sel) {
    fields.forEach(function (f) {
      var rows = form.querySelectorAll('[data-field="' + f + '"] .disk-picker-row');
      rows.forEach(function (row) {
        var cb = row.querySelector('input[type="checkbox"]');
        if (!cb) return;
        var path = cb.value;
        var elsewhere = false;
        for (var i = 0; i < fields.length; i++) {
          if (fields[i] !== f && sel[fields[i]].has(path)) { elsewhere = true; break; }
        }
        if (elsewhere && !cb.checked) {
          row.setAttribute('aria-disabled', 'true');
          cb.disabled = true;
          row.title = msgs.duplicate_disk || '';
        } else {
          row.removeAttribute('aria-disabled');
          cb.disabled = false;
          row.removeAttribute('title');
        }
      });
    });
  }

  // Wire the standard submit-button gating + submit blocking via kura.gateForm.
  // The validate callback returns the error list; kura handles aria-disabled +
  // tooltip + preventDefault on submit when invalid.
  if (window.kura && typeof window.kura.gateForm === 'function') {
    window.kura.gateForm(form, function (frm) {
      var sel = {};
      fields.forEach(function (f) { sel[f] = selectedSet(f); });
      applyDedup(sel);

      var errs = [];
      var nameInput = frm.querySelector('input[name="name"]');
      if (!nameInput || !(nameInput.value || '').trim()) errs.push(msgs.name_required);

      var dataLayoutEl = frm.querySelector('select[name="data_layout"]');
      var dataLayout = dataLayoutEl ? dataLayoutEl.value : '';
      if (!dataLayout) {
        errs.push(msgs.data_layout_required);
      } else {
        var dmin = layoutMin[dataLayout] || 1;
        var dgot = sel.data_disks.size;
        if (dgot < dmin) {
          errs.push(fmt(msgs.data_too_few, { layout: dataLayout, min: dmin, got: dgot }));
        }
      }

      var specialLayoutEl = frm.querySelector('select[name="special_layout"]');
      var specialLayout = specialLayoutEl ? specialLayoutEl.value : '';
      var sgot = sel.special_disks.size;
      if (specialLayout || sgot > 0) {
        if (!specialLayout) {
          errs.push(msgs.special_layout_required);
        } else {
          var smin = layoutMin[specialLayout] || 0;
          if (sgot < smin) {
            errs.push(fmt(msgs.special_too_few, { layout: specialLayout, min: smin, got: sgot }));
          }
        }
      }
      return errs;
    });
  }
})();
</script>
{{ end }}
{{ end }}

{{- /* ===== Body / foot definitions for the modal partials =====
   Each define block is a top-level template; the "modal" partial reaches
   them via the `tpl` template func at render time. Naming convention:
   {{page-id}}-{{form-id}}-body / -foot to avoid collisions across pages. */ -}}

{{ define "storage-import-modal-body" }}
<div style="display:flex;flex-direction:column;gap:12px">
  <input type="hidden" name="name" value="{{ .Name }}">
  <div class="field">
    <label style="font-size:12px;color:var(--text-3)">{{ T "page.storage.import.col.topology" }}</label>
    <div class="mono" style="font-size:12px">{{ .Topology }}</div>
  </div>
  <label class="row center" style="display:flex;gap:8px;align-items:flex-start;font-size:13px">
    <input type="checkbox" name="force" value="1" data-testid="storage-import-force-checkbox">
    <span>
      <div>{{ T "page.storage.import.force" }}</div>
      <div style="font-size:11px;color:var(--warn);margin-top:2px">{{ T "page.storage.import.force_warn" }}</div>
    </span>
  </label>
</div>
{{ end }}

{{ define "storage-import-modal-foot" }}
<button type="button" class="btn" data-modal-close>{{ T "page.storage.new_pool.cancel" }}</button>
<button type="submit" class="btn btn-primary" data-testid="storage-import-submit-btn">
  {{ T "page.storage.import.submit" }}
</button>
{{ end }}

{{ define "storage-new-pool-body" }}
{{ $v := . }}
<div style="display:flex;flex-direction:column;gap:14px">
  <div class="field">
    <label>{{ T "page.storage.new_pool.name" }}</label>
    <input class="input mono" name="name" required data-testid="storage-new-pool-name">
    <div class="field-hint">{{ T "page.storage.new_pool.name_hint" }}</div>
  </div>
  <div class="field">
    <label>{{ T "page.storage.new_pool.layout" }}</label>
    <select name="data_layout" class="input" required data-testid="storage-new-pool-layout">
      {{ range $v.Layouts }}
      <option value="{{ .ID }}">{{ .Label }}</option>
      {{ end }}
    </select>
  </div>
  <div class="field">
    <label>{{ T "page.storage.new_pool.disks" }}</label>
    {{ template "disk-picker" dict "Disks" $v.FreeDisks "Field" "data_disks" "Required" true "Testid" "storage-new-pool-disks" }}
    <div class="field-hint">{{ T "page.storage.new_pool.disks_hint" }}</div>
  </div>
  <details>
    <summary style="cursor:pointer;font-size:13px;color:var(--text-2)">{{ T "page.storage.new_pool.special" }}</summary>
    <div class="field" style="margin-top:8px">
      <label>{{ T "page.storage.new_pool.layout" }}</label>
      <select name="special_layout" class="input">
        <option value="">—</option>
        <option value="mirror">mirror</option>
        <option value="raidz1">raidz1</option>
        <option value="raidz2">raidz2</option>
        <option value="raidz3">raidz3</option>
      </select>
    </div>
    <div class="field">
      <label>{{ T "page.storage.new_pool.disks" }}</label>
      {{ template "disk-picker" dict "Disks" $v.FreeDisks "Field" "special_disks" "Required" false "Testid" "storage-new-pool-special-disks" }}
      <div class="field-hint">{{ T "page.storage.new_pool.special_hint" }}</div>
    </div>
  </details>
  <details>
    <summary style="cursor:pointer;font-size:13px;color:var(--text-2)">{{ T "page.storage.new_pool.spares" }}</summary>
    <div class="field" style="margin-top:8px">
      {{ template "disk-picker" dict "Disks" $v.FreeDisks "Field" "spares" "Required" false "Testid" "storage-new-pool-spares" }}
    </div>
  </details>
</div>
{{ end }}

{{ define "storage-new-pool-foot" }}
<button type="button" class="btn" data-modal-close>{{ T "page.storage.new_pool.cancel" }}</button>
<button type="submit" class="btn btn-primary"
  data-testid="storage-new-pool-submit"
  data-validate-submit
  aria-disabled="true" title="">
  {{ T "page.storage.new_pool.submit" }}
</button>
{{ end }}
