{{- /*
apps_progress.tmpl — install/update SSE progress card.
Returned by /ui/admin/apps/install/start.

Connects to {{ .StreamURL }} via EventSource (the small inline script below
is sufficient — keeps the htmx sse extension out of the dist for now).
*/ -}}
<div class="modal" data-testid="apps-progress-modal" style="display:block">
  <div class="card">
    <div class="card-head"><h3 class="card-title">{{ .Title }}</h3></div>
    <div class="card-body">
      <p class="muted">{{ .AppName }} (<span class="mono">{{ .AppID }}</span>)</p>
      <ul id="apps-progress-list" data-testid="apps-progress-list" style="list-style:none;padding:0;margin:0;font-size:13px"></ul>
      <div id="apps-progress-final" data-testid="apps-progress-final" style="margin-top:12px"></div>
    </div>
    <div class="card-foot" style="justify-content:flex-end">
      <button type="button" class="btn" data-testid="apps-progress-close"
              hx-on:click="document.getElementById('apps-modal-target').innerHTML='';location.reload()">
        閉じる
      </button>
    </div>
  </div>
</div>
<script>
(function(){
  var list = document.getElementById('apps-progress-list');
  var final = document.getElementById('apps-progress-final');
  if (!list || typeof EventSource === 'undefined') return;
  var es = new EventSource({{ .StreamURL | safeJS }});
  es.addEventListener('progress', function(e){
    try {
      var d = JSON.parse(e.data);
      var li = document.createElement('li');
      li.setAttribute('data-stage', d.stage);
      li.setAttribute('data-ok', d.ok ? 'true' : 'false');
      li.style.padding = '4px 0';
      li.style.borderBottom = '1px solid var(--border)';
      li.innerHTML = '<span style="color:' + (d.ok ? 'var(--ok,green)' : 'var(--crit,red)') + '">' +
        (d.ok ? '✓ ' : '✗ ') + '</span>' +
        '<strong>' + (d.label || d.stage) + '</strong> ' +
        '<span class="muted">' + d.detail + '</span>';
      list.appendChild(li);
      if (d.final) {
        final.setAttribute('data-final-ok', d.ok ? 'true' : 'false');
        final.innerHTML = '<div class="banner ' + (d.ok ? 'ok' : 'crit') + '">' +
          (d.ok ? 'インストール完了' : 'インストール失敗: ' + d.detail) + '</div>';
        es.close();
      }
    } catch (err) {}
  });
  es.addEventListener('open', function(){});
  es.addEventListener('timeout', function(){ es.close(); });
})();
</script>
