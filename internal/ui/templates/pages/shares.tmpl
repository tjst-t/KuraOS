{{- /*
shares.tmpl — admin /ui/admin/shares page. Visual SSOT is
prototype/claude_design/Shares.html: shares table + per-share detail card +
"best defaults applied" knob list. Form is single-step: pick name + path +
preset + access mode + optional ACL — no SMB tunables (priority #2).

The "New share" dialog uses the reusable {{ template "modal" }} partial
(see internal/ui/templates/partials/modal.tmpl). Modal behaviors
(scroll lock, ESC, backdrop close, data-modal-open / data-modal-close)
are auto-wired by /ui/static/kura.js.

Data shape: PageData.Extra is a SharesView. All strings are pre-translated
in shares.go so the template stays free of CLI-output tokens.
*/ -}}
{{ define "content" }}
{{ $v := .Extra }}
<div class="page-head">
  <div>
    <h1 class="page-title">{{ T "page.shares.title" }}</h1>
    <p class="page-sub">{{ $v.Subtitle }}</p>
  </div>
  <div class="row gap-sm" style="display:flex;gap:8px;">
    <button type="button" class="btn btn-primary" data-testid="shares-new-btn"
      data-modal-open="new-share-modal">
      {{ T "page.shares.new" }}
    </button>
  </div>
</div>

{{ if $v.FormError }}
<div class="banner crit" data-testid="shares-error" style="margin-bottom:20px">
  <div style="flex:1">{{ $v.FormError }}</div>
</div>
{{ end }}

{{ if $v.HasShares }}
<div class="grid" style="display:grid;grid-template-columns:1.4fr 1fr;gap:24px;align-items:flex-start;">
  <div class="card" data-testid="shares-list">
    <table class="tbl">
      <thead><tr>
        <th>{{ T "page.shares.col.name" }}</th>
        <th>{{ T "page.shares.col.protocol" }}</th>
        <th>{{ T "page.shares.col.path" }}</th>
        <th>{{ T "page.shares.col.preset" }}</th>
        <th>{{ T "page.shares.col.access" }}</th>
        <th>{{ T "page.shares.col.status" }}</th>
      </tr></thead>
      <tbody>
        {{ range $v.Shares }}
        <tr data-testid="shares-row"
            data-share-id="{{ .ID }}"
            data-share-name="{{ .Name }}"
            data-row-link="/ui/admin/shares?selected={{ .ID }}"
            {{ if eq $v.SelectedID .ID }}aria-selected="true"{{ end }}
            style="cursor:pointer">
          <td><strong>{{ .Name }}</strong></td>
          <td><span class="badge">{{ .ProtocolLabel }}</span></td>
          <td class="td-mono">{{ .Path }}</td>
          <td>{{ .PresetLabel }}</td>
          <td>{{ .AccessLabel }}</td>
          <td>
            <span class="badge {{ .StatusClass }}" data-status="{{ .StatusID }}">
              <span class="badge-dot"></span>{{ .StatusLabel }}
            </span>
          </td>
        </tr>
        {{ end }}
      </tbody>
    </table>
  </div>

  {{ if not $v.Selected }}
  <div class="card" data-testid="shares-detail-empty">
    <div class="card-body" style="padding:48px 24px;text-align:center">
      <p class="muted" style="margin:0;font-size:13px">{{ T "page.shares.detail.placeholder" }}</p>
    </div>
  </div>
  {{ else }}
  <div class="card" data-testid="shares-detail">
    <div class="card-head">
      <div>
        <h3 class="card-title">{{ $v.Selected.Name }}</h3>
        <p class="card-sub mono">{{ $v.Selected.Path }}</p>
      </div>
      <span class="badge {{ $v.Selected.StatusClass }}"><span class="badge-dot"></span>{{ $v.Selected.StatusLabel }}</span>
    </div>
    <div class="card-body col" style="display:flex;flex-direction:column;gap:12px;">
      <div class="row gap-lg" style="display:flex;gap:16px;">
        <div class="stat" style="flex:1">
          <div class="stat-label">{{ T "page.shares.col.preset" }}</div>
          <div class="stat-value" style="font-size:14px">{{ $v.Selected.PresetLabel }}</div>
        </div>
        <div class="stat" style="flex:1">
          <div class="stat-label">{{ T "page.shares.col.access" }}</div>
          <div class="stat-value" style="font-size:14px">{{ $v.Selected.AccessLabel }}</div>
        </div>
      </div>
      {{ if $v.Selected.ACL }}
      <div>
        <div class="stat-label" style="margin-bottom:8px">{{ T "page.shares.form.acl" }}</div>
        <div class="col gap-sm" style="display:flex;flex-direction:column;gap:6px;">
          {{ range $v.Selected.ACL }}
          <div class="row center between" data-testid="shares-acl-row" style="display:flex;justify-content:space-between;align-items:center;padding:8px 12px;background:var(--bg);border-radius:6px;border:1px solid var(--border);">
            <span class="mono" style="font-size:13px;">{{ .Token }}</span>
            <span class="badge">{{ .ModeLabel }}</span>
          </div>
          {{ end }}
        </div>
      </div>
      {{ end }}
    </div>
    <div class="card-foot" style="display:flex;justify-content:space-between;align-items:center;padding:12px 18px;border-top:1px solid var(--border);gap:8px">
      <span class="muted mono" style="font-size:11px;">id: {{ $v.Selected.ID }}</span>
      <div class="row gap-sm" style="display:flex;gap:6px">
        <button type="button" class="btn btn-sm" data-testid="shares-edit-btn"
          data-modal-open="edit-share-modal">{{ T "page.shares.edit" }}</button>
        <form method="post" action="/ui/admin/shares/delete" data-testid="shares-delete-form" onsubmit="return confirm('Delete share {{ $v.Selected.Name }}?');">
          <input type="hidden" name="id" value="{{ $v.Selected.ID }}" />
          <button type="submit" class="btn btn-sm btn-danger" data-testid="shares-delete-btn">削除</button>
        </form>
      </div>
    </div>
  </div>
  {{ end }}
</div>

{{ if $v.Selected }}
{{ template "modal" dict
    "id"      "edit-share-modal"
    "testid"  "shares-edit-modal"
    "title"   (T "page.shares.edit.title")
    "action"  "/ui/admin/shares/update"
    "bodyTpl" "shares-edit-body"
    "footTpl" "shares-edit-foot"
    "ctx"     $v }}
{{ end }}
{{ else }}
<div class="card" data-testid="shares-empty" style="padding:40px;text-align:center;">
  <p class="muted">{{ T "page.shares.empty" }}</p>
</div>
{{ end }}

<section style="margin-top:24px" class="card" data-testid="shares-defaults">
  <div class="card-head">
    <h3 class="card-title">{{ $v.DefaultsHeading }}</h3>
    <span class="badge"><span class="badge-dot"></span>best defaults applied</span>
  </div>
  <div class="card-body">
    <p class="muted" style="margin:0 0 12px 0;font-size:12px;">{{ $v.DefaultsLead }}</p>
    <table class="tbl">
      <thead><tr><th>オプション</th><th>値</th><th>説明</th></tr></thead>
      <tbody>
        {{ range $v.Defaults }}
        <tr data-testid="shares-default-row">
          <td class="td-mono">{{ .Key }}</td>
          <td class="td-mono"><span class="badge">{{ .Value }}</span></td>
          <td class="muted">{{ .Note }}</td>
        </tr>
        {{ end }}
      </tbody>
    </table>
  </div>
</section>

{{- /* ===== New share dialog (reusable modal partial) ===== */ -}}
{{ template "modal" dict
    "id"      "new-share-modal"
    "testid"  "shares-new-modal"
    "title"   (T "page.shares.new")
    "action"  "/ui/admin/shares"
    "bodyTpl" "shares-new-body"
    "footTpl" "shares-new-foot"
    "ctx"     $v }}
{{ end }}

{{- /* ===== Body / foot definitions for the new-share modal ===== */ -}}

{{ define "shares-new-body" }}
{{ $v := . }}
<div data-testid="shares-new-form" style="display:flex;flex-direction:column;gap:14px;">
  <div class="field">
    <label for="share-name">{{ T "page.shares.form.name" }}</label>
    <input id="share-name" name="name" type="text" class="input" required autocomplete="off" data-testid="shares-form-name">
    <p class="field-hint" style="margin:0;">{{ T "page.shares.form.name_hint" }}</p>
  </div>
  <div class="field" data-testid="shares-form-path-field">
    <label>{{ T "page.shares.form.path" }}</label>
    <div class="row gap-sm" style="display:flex;gap:12px;font-size:13px;">
      <label class="row center" style="display:flex;gap:6px;align-items:center;cursor:pointer;">
        <input type="radio" name="path_mode" value="dataset"{{ if $v.AvailableDatasets }} checked{{ end }}
               data-radio-shows="shares-form-path-dataset-pane"
               data-testid="shares-form-path-mode-dataset">
        <span>{{ T "page.shares.form.path_mode_dataset" }}</span>
      </label>
      <label class="row center" style="display:flex;gap:6px;align-items:center;cursor:pointer;">
        <input type="radio" name="path_mode" value="freetext"{{ if not $v.AvailableDatasets }} checked{{ end }}
               data-radio-shows="shares-form-path-freetext-pane"
               data-testid="shares-form-path-mode-freetext">
        <span>{{ T "page.shares.form.path_mode_freetext" }}</span>
      </label>
    </div>

    <div data-testid="shares-form-path-dataset-pane"
         style="margin-top:8px;{{ if not $v.AvailableDatasets }}display:none;{{ end }}">
      {{ if $v.AvailableDatasets }}
      <select name="path_dataset" class="input mono" data-testid="shares-form-path-dataset">
        {{ range $v.AvailableDatasets }}
        <option value="{{ if .MountPoint }}{{ .MountPoint }}{{ else }}/{{ .Name }}{{ end }}" data-dataset="{{ .Name }}">
          {{ .Name }}{{ if .MountPoint }} ({{ .MountPoint }}){{ end }}
        </option>
        {{ end }}
      </select>
      <p class="field-hint" style="margin:4px 0 0 0;">{{ T "page.shares.form.path_dataset_hint" }}</p>
      {{ else }}
      <p class="field-hint" style="margin:4px 0 0 0;">{{ T "page.shares.form.path_no_datasets" }}</p>
      {{ end }}
    </div>

    <div data-testid="shares-form-path-freetext-pane"
         style="margin-top:8px;{{ if $v.AvailableDatasets }}display:none;{{ end }}">
      <input name="path_freetext" type="text" class="input mono" placeholder="/tank/photos" data-testid="shares-form-path-freetext">
      <p class="field-hint" style="margin:4px 0 0 0;">{{ T "page.shares.form.path_hint" }}</p>
    </div>
  </div>
  <div class="field">
    <label for="share-protocol">{{ T "page.shares.form.protocol" }}</label>
    <select id="share-protocol" name="protocol" class="input" data-testid="shares-form-protocol">
      {{ range $v.Protocols }}<option value="{{ .ID }}">{{ .Label }}</option>{{ end }}
    </select>
  </div>
  <div class="field">
    <label>{{ T "page.shares.form.preset" }}</label>
    <div class="col gap-sm" style="display:flex;flex-direction:column;gap:6px;" data-testid="shares-form-preset-group">
      {{ range $i, $p := $v.Presets }}
      <label class="row center" style="display:flex;align-items:flex-start;gap:8px;padding:8px;border:1px solid var(--border);border-radius:6px;cursor:pointer;">
        <input type="radio" name="preset" value="{{ .ID }}"{{ if eq $i 0 }} checked{{ end }} data-testid="shares-form-preset-{{ .ID }}">
        <span style="display:flex;flex-direction:column;gap:2px;">
          <strong style="font-size:13px;">{{ .Label }}</strong>
          <span class="muted" style="font-size:11px;">{{ .Hint }}</span>
        </span>
      </label>
      {{ end }}
    </div>
  </div>
  <div class="field">
    <label for="share-access">{{ T "page.shares.form.access" }}</label>
    <select id="share-access" name="access_mode" class="input" data-testid="shares-form-access">
      {{ range $v.Access }}<option value="{{ .ID }}">{{ .Label }}</option>{{ end }}
    </select>
  </div>
  <div class="field">
    <label>{{ T "page.shares.form.acl" }}</label>
    <div id="acl-rows-new" data-testid="shares-acl-rows" data-acl-rows-target="true" style="display:flex;flex-direction:column;">
      {{ if not $v.AvailableUsers }}
        {{ if not $v.AvailableGroups }}
        <p class="muted" data-testid="shares-acl-empty" style="margin:0;font-size:12px;">{{ T "page.shares.acl.picker.empty" }}</p>
        {{ end }}
      {{ end }}
    </div>
    <button type="button" class="btn btn-sm" data-testid="shares-acl-add-btn"
            hx-get="/ui/admin/shares/acl-row"
            hx-target="#acl-rows-new"
            hx-swap="beforeend">
      {{ T "page.shares.acl.picker.add_btn" }}
    </button>
  </div>
  <div class="field">
    <label for="share-description">{{ T "page.shares.form.description" }}</label>
    <input id="share-description" name="description" type="text" class="input" autocomplete="off" data-testid="shares-form-description">
  </div>
</div>
{{ end }}

{{ define "shares-new-foot" }}
<button type="button" class="btn" data-modal-close data-testid="shares-new-cancel">
  {{ T "page.shares.form.cancel" }}
</button>
<button type="submit" class="btn btn-primary" data-testid="shares-form-submit">
  {{ T "page.shares.form.submit" }}
</button>
{{ end }}

{{- /* ===== Edit Share modal body / foot =====
   Pre-fills from $v.Selected. Name and Path are not editable — UpdateInput
   in engine/share/share.go intentionally omits them, so they're shown
   read-only in the modal. */ -}}
{{ define "shares-edit-body" }}
{{ $v := . }}
{{ $sel := $v.Selected }}
<div data-testid="shares-edit-form" style="display:flex;flex-direction:column;gap:14px;">
  <input type="hidden" name="id" value="{{ $sel.ID }}">

  <div class="field">
    <label>{{ T "page.shares.form.name" }}</label>
    <div class="mono">{{ $sel.Name }}</div>
    <p class="field-hint" style="margin:0;">{{ T "page.shares.edit.name_immutable" }}</p>
  </div>
  <div class="field">
    <label>{{ T "page.shares.form.path" }}</label>
    <div class="mono">{{ $sel.Path }}</div>
    <p class="field-hint" style="margin:0;">{{ T "page.shares.edit.path_immutable" }}</p>
  </div>

  <div class="field">
    <label for="edit-share-protocol">{{ T "page.shares.form.protocol" }}</label>
    <select id="edit-share-protocol" name="protocol" class="input" data-testid="shares-edit-protocol">
      {{ range $v.Protocols }}<option value="{{ .ID }}"{{ if eq .ID $sel.ProtocolID }} selected{{ end }}>{{ .Label }}</option>{{ end }}
    </select>
  </div>
  <div class="field">
    <label>{{ T "page.shares.form.preset" }}</label>
    <div class="col gap-sm" style="display:flex;flex-direction:column;gap:6px;">
      {{ range $v.Presets }}
      <label class="row center" style="display:flex;align-items:flex-start;gap:8px;padding:8px;border:1px solid var(--border);border-radius:6px;cursor:pointer;">
        <input type="radio" name="preset" value="{{ .ID }}"{{ if eq .ID $sel.PresetID }} checked{{ end }} data-testid="shares-edit-preset-{{ .ID }}">
        <span style="display:flex;flex-direction:column;gap:2px;">
          <strong style="font-size:13px;">{{ .Label }}</strong>
          <span class="muted" style="font-size:11px;">{{ .Hint }}</span>
        </span>
      </label>
      {{ end }}
    </div>
  </div>
  <div class="field">
    <label for="edit-share-access">{{ T "page.shares.form.access" }}</label>
    <select id="edit-share-access" name="access_mode" class="input" data-testid="shares-edit-access">
      {{ range $v.Access }}<option value="{{ .ID }}"{{ if eq .ID $sel.AccessID }} selected{{ end }}>{{ .Label }}</option>{{ end }}
    </select>
  </div>
  <div class="field">
    <label>{{ T "page.shares.form.acl" }}</label>
    <div id="acl-rows-edit-{{ $sel.ID }}" data-testid="shares-edit-acl-rows" data-acl-rows-target="true" style="display:flex;flex-direction:column;">
      {{ range $a := $sel.ACL }}
      {{ template "share-acl-row" (dict
          "Users" $v.AvailableUsers
          "Groups" $v.AvailableGroups
          "Modes" $v.ACLModeOptions
          "SelectedKind" $a.Kind
          "SelectedName" $a.Name
          "SelectedMode" $a.ModeID) }}
      {{ end }}
      {{ if not $sel.ACL }}
      <p class="muted" data-testid="shares-edit-acl-empty" style="margin:0;font-size:12px;">{{ T "page.shares.acl.picker.empty" }}</p>
      {{ end }}
    </div>
    <button type="button" class="btn btn-sm" data-testid="shares-edit-acl-add-btn"
            hx-get="/ui/admin/shares/acl-row"
            hx-target="#acl-rows-edit-{{ $sel.ID }}"
            hx-swap="beforeend">
      {{ T "page.shares.acl.picker.add_btn" }}
    </button>
  </div>
  <div class="field">
    <label for="edit-share-description">{{ T "page.shares.form.description" }}</label>
    <input id="edit-share-description" name="description" type="text" class="input" autocomplete="off"
           value="{{ $sel.Description }}" data-testid="shares-edit-description">
  </div>
</div>
{{ end }}

{{ define "shares-edit-foot" }}
<button type="button" class="btn" data-modal-close data-testid="shares-edit-cancel">
  {{ T "page.shares.form.cancel" }}
</button>
<button type="submit" class="btn btn-primary" data-testid="shares-edit-submit">
  {{ T "page.shares.edit.submit" }}
</button>
{{ end }}
