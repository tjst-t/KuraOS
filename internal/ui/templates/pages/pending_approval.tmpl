{{- /*
pending_approval.tmpl — shown to federated users whose account is pending
admin approval. They have a valid session (role=pending) but cannot access
any functional UI until an admin promotes them. No sidebar navigation — the
operator has not been granted access yet. Matches the center-shell card
pattern used by login.tmpl and federation_error.tmpl.
*/ -}}
{{ define "content" }}
<div class="center-shell">
  <div class="card" style="max-width:420px;width:100%;">
    <div class="card-body" style="padding:32px;">
      <div style="display:flex;align-items:center;gap:10px;margin-bottom:20px;">
        <div class="brand-mark">{{ template "brand-mark" . }}</div>
        <div>
          <div class="brand-name">{{ T "brand.name" }}</div>
          <div class="brand-sub">v{{ .Version }}</div>
        </div>
      </div>
      <h1 class="page-title" style="font-size:22px;margin:4px 0 6px;" data-testid="pending-approval-title">
        {{ T "page.pending_approval.title" }}
      </h1>
      <p class="page-sub" style="margin-bottom:24px;" data-testid="pending-approval-body">
        {{ T "page.pending_approval.body" }}
      </p>
      <form method="post" action="/logout" data-testid="pending-approval-logout-form">
        <button type="submit" class="btn" data-testid="pending-approval-logout-btn"
                style="justify-content:center;padding:9px 16px;width:100%;">
          {{ T "page.pending_approval.logout_button" }}
        </button>
      </form>
    </div>
  </div>
</div>
{{ end }}
