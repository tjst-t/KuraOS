{{- /*
sidebar partial. Mirrors prototype/claude_design/shared/shared.jsx Sidebar()
output: brand head + nav groups + sidebar foot. NavItems come from .Sidebar
on the page data so the active item is decided server-side.
*/ -}}
{{ define "sidebar" }}
<aside class="sidebar" aria-label="{{ T "nav.section.admin" }}">
  <div class="sidebar-head">
    <div class="brand-mark">
      {{ template "brand-mark" . }}
    </div>
    <div>
      <div class="brand-name">{{ T "brand.name" }}</div>
      <div class="brand-sub">v{{ .Version }}</div>
    </div>
  </div>
  <nav class="nav" data-testid="sidebar-nav">
    {{ range .Sidebar.Groups }}
    <div class="nav-section-label">{{ T .LabelID }}</div>
    {{ range .Items }}
    <a
      href="{{ .Href }}"
      class="nav-item"
      data-active="{{ if .Active }}true{{ else }}false{{ end }}"
      data-nav-id="{{ .ID }}"
    >
      {{ template "icon" .Icon }}
      <span class="nav-label">{{ T .LabelID }}</span>
      {{ if .Badge }}<span class="nav-badge">{{ .Badge }}</span>{{ end }}
    </a>
    {{ end }}
    {{ end }}
  </nav>
  <div class="sidebar-foot">
    <div class="avatar">{{ .User.Initials }}</div>
    <div class="sidebar-foot-info">
      <div class="name">{{ .User.Name }}</div>
      <div class="role">{{ T .User.RoleID }}</div>
    </div>
    <form method="POST" action="/logout" style="margin:0">
      <button type="submit" class="btn btn-icon btn-ghost"
              data-testid="sidebar-logout-btn"
              title="{{ T "nav.logout" }}"
              aria-label="{{ T "nav.logout" }}"
              style="flex:none;width:28px;height:28px;padding:0;display:grid;place-items:center;color:var(--text-3)">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor"
             stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/>
          <polyline points="16 17 21 12 16 7"/>
          <line x1="21" y1="12" x2="9" y2="12"/>
        </svg>
      </button>
    </form>
  </div>
</aside>
{{ end }}
