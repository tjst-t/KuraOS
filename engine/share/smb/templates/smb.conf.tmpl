# Generated by KuraOS — do not edit by hand. Regenerated on every config apply.
# Source of truth: SQLite shares table + config.json. Manual edits will be lost.

[global]
   workgroup = {{ .Workgroup }}
   server string = KuraOS
   server role = standalone server
   server min protocol = SMB2
   client min protocol = SMB2
   server signing = auto
   server multi channel support = yes
   use sendfile = yes
   aio read size = 1
   aio write size = 1
   socket options = TCP_NODELAY IPTOS_LOWDELAY
   smb encrypt = desired
   # KuraOS users live in the credential vault, not in /etc/shadow — PAM
   # account_check would reject them. Disable so vault-managed users can
   # authenticate at the SMB layer (Ssys001).
   obey pam restrictions = no
   ea support = yes
   inherit acls = yes
   inherit permissions = yes
   map archive = no
   map hidden = no
   map system = no
   store dos attributes = yes
   load printers = no
   printing = bsd
   printcap name = /dev/null
   disable spoolss = yes
   log level = 1
   log file = /var/log/samba/log.%m
   max log size = 1000
{{ range .Shares }}
[{{ .Name }}]
   path = {{ .Path }}
   comment = {{ .Comment }}
   browseable = yes
   read only = {{ if eq .DefaultMode "read_only" }}yes{{ else }}no{{ end }}
   guest ok = no
{{- if .ValidUsers }}
   valid users = {{ .ValidUsers }}
{{- end }}
{{- if .WriteList }}
   write list = {{ .WriteList }}
{{- end }}
{{- if .ReadList }}
   read list = {{ .ReadList }}
{{- end }}
{{- if .InvalidUsers }}
   invalid users = {{ .InvalidUsers }}
{{- end }}
   create mask = 0664
   directory mask = 0775
{{- if .Params.VfsObjects }}
   vfs objects = {{ .Params.VfsObjects }}
{{- end }}
   oplocks = {{ .Params.Oplocks }}
{{- if .Params.StrictLocking }}
   strict locking = {{ .Params.StrictLocking }}
{{- end }}
{{- if .Params.Sync }}
   sync always = {{ if eq .Params.Sync "always" }}yes{{ else }}no{{ end }}
{{- end }}
{{- if .Params.FruitTimeMachine }}
   fruit:time machine = {{ .Params.FruitTimeMachine }}
{{- end }}
{{- if .Params.FruitMetadata }}
   fruit:metadata = {{ .Params.FruitMetadata }}
{{- end }}
{{- if .Params.FruitPosixRename }}
   fruit:posix_rename = {{ .Params.FruitPosixRename }}
{{- end }}
{{- if .Params.VetoFiles }}
   veto files = {{ .Params.VetoFiles }}
{{- end }}
{{- if .Params.CaseSensitive }}
   case sensitive = {{ .Params.CaseSensitive }}
{{- end }}
{{ end }}
