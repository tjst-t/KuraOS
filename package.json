{
  "name": "kuraos-ui",
  "version": "0.0.0",
  "private": true,
  "description": "Tailwind CSS build pipeline for KuraOS admin UI. Compiled output is embedded into the kura binary via embed.FS.",
  "scripts": {
    "build:css": "tailwindcss -c tailwind.config.js -i internal/ui/src/kura.css -o internal/ui/dist/kura.css --minify",
    "watch:css": "tailwindcss -c tailwind.config.js -i internal/ui/src/kura.css -o internal/ui/dist/kura.css --watch"
  },
  "devDependencies": {
    "tailwindcss": "^3.4.13"
  }
}
